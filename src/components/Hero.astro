---
// Hero.astro — primeira dobra. Fundo animado em CSS puro (sem JS, sem libs)
// até você plugar um <video> ou imagem real do Luma/Runway.
---
<section class="hero" id="hero" aria-label="Introduction">
  <div class="bg" aria-hidden="true">
    <div class="grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="vignette"></div>
  </div>

  <div class="content">
    <p class="kicker">
      <span class="dot" aria-hidden="true"></span>
      A new multiverse is generating
    </p>

    <h1>
      <span class="line">MONDO</span>
      <span class="line grad">CREATURES</span>
    </h1>

    <p class="tagline">
      An expanding sci-fi fantasy universe. Discover original creatures
      born at the intersection of science, AI, and cinematic art.
    </p>
  </div>

  <a href="#about" class="scroll" aria-label="Scroll to next section">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 6rem 1.5rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 50% 30%, #0d1024 0%, #06060c 60%);
  }

  .grid {
    position: absolute;
    inset: -1px;
    background-image:
      linear-gradient(to right, rgba(0, 229, 255, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 229, 255, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    will-change: transform;
    animation: drift 20s ease-in-out infinite alternate;
  }
  .orb-1 { width: 500px; height: 500px; background: var(--accent);   top: -140px; left: -140px; }
  .orb-2 { width: 440px; height: 440px; background: var(--accent-2); bottom: -160px; right: -120px; animation-delay: -7s; }
  .orb-3 { width: 380px; height: 380px; background: var(--accent-3); top: 45%; left: 50%; transform: translate(-50%, -50%); animation-delay: -14s; opacity: 0.32; }

  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(40px, -30px) scale(1.1); }
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.65) 100%);
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-dim);
    border: 1px solid var(--line);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    margin-bottom: 1.6rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: 0.3; } }

  h1 {
    font-size: clamp(3rem, 11vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    margin-bottom: 1.2rem;
  }
  .line { display: block; }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--fg-dim);
    max-width: 560px;
    margin: 0 auto 2.5rem;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .scroll {
    position: absolute;
    bottom: 2.2rem; left: 50%;
    transform: translateX(-50%);
    width: 24px; height: 38px;
    border: 1px solid var(--line);
    border-radius: 12px;
    z-index: 1;
  }
  .scroll span {
    position: absolute;
    top: 6px; left: 50%;
    transform: translateX(-50%);
    width: 3px; height: 8px;
    border-radius: 2px;
    background: var(--fg-dim);
    animation: scroll-anim 1.8s ease-in-out infinite;
  }
  @keyframes scroll-anim {
    0%   { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 14px); }
  }

</style>
