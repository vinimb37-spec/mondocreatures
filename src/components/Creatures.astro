---
// Creatures.astro — grid de placeholders 9:11 (vertical) para casar com
// o formato de vídeo vertical que vai entrar depois (Luma/Runway).
// Quando os vídeos chegarem, basta trocar o conteúdo de .thumb por um <video>
// (ou <Image> do Astro pra thumbnail estática).

const creatures = [
  { id: 'I'   },
  { id: 'II'  },
  { id: 'III' },
  { id: 'IV'  },
  { id: 'V'   },
  { id: 'VI'  },
];
---
<section class="creatures" id="creatures" aria-label="Featured creatures">
  <div class="container">
    <p class="eyebrow">// Field Notes</p>
    <h2>The first specimens are emerging.</h2>
    <p class="lead">
      A glimpse of what's incubating. Each tile will reveal a creature,
      a habitat and a short film when the canon goes live.
    </p>

    <div class="grid">
      {creatures.map((c) => (
        <article class="card" aria-label={`Specimen ${c.id}`}>
          <div class="thumb" aria-hidden="true">
            <span class="roman">{c.id}</span>
            <span class="badge">Locked</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .creatures {
    padding: 8rem 1.5rem;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .container { max-width: var(--max-w); margin: 0 auto; }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 1.2rem;
  }
  h2 {
    font-size: clamp(1.9rem, 4.5vw, 3.2rem);
    max-width: 18ch;
    margin-bottom: 1.5rem;
  }
  .lead {
    color: var(--fg-dim);
    max-width: 60ch;
    margin-bottom: 4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.2rem;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-2);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 229, 255, 0.3);
  }

  .thumb {
    position: relative;
    aspect-ratio: 9 / 11;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 30%, rgba(0, 229, 255, 0.18), transparent 60%),
      radial-gradient(circle at 70% 70%, rgba(255, 43, 214, 0.18), transparent 60%),
      var(--bg-3);
    overflow: hidden;
  }
  .thumb::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .roman {
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    color: var(--fg);
    opacity: 0.85;
    text-shadow: 0 0 28px rgba(0, 229, 255, 0.45);
  }

  .badge {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--fg-dim);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

</style>
