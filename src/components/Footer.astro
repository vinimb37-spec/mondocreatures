---
// Footer.astro — links sociais e copyright. Substitua os href="#" pelos
// seus perfis reais quando criar as contas.
const year = new Date().getFullYear();

const socials = [
  { label: 'YouTube', href: 'https://www.youtube.com/@MondoCreatures' },
  { label: 'X',       href: 'https://x.com/MondoCreatures' },
];
---
<footer class="footer" id="footer" aria-label="Site footer">
  <div class="container">
    <div class="brand">
      <p class="logo">MONDO<span>CREATURES</span></p>
      <p class="tag">An expanding sci-fi fantasy universe of original species.</p>
    </div>

    <nav aria-label="Social links">
      <ul class="social">
        {socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" aria-label={s.label}>{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="bottom">
    <p>© {year} Mondo Creatures. All creatures are fictional.</p>
    <p class="mono">v0.2 · live</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 5rem 1.5rem 2rem;
    background: var(--bg-2);
  }

  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
  }

  .logo {
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .logo span {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-left: 0.4rem;
  }
  .tag {
    color: var(--fg-dim);
    margin-top: 0.4rem;
    font-size: 0.9rem;
  }

  .social {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .social a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-dim);
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
    padding-bottom: 2px;
  }
  .social a:hover {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .bottom {
    max-width: var(--max-w);
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    color: var(--fg-dim);
    font-size: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .mono { font-family: var(--font-mono); }

  @media (max-width: 600px) {
    .container { grid-template-columns: 1fr; }
  }
</style>
